{
  "name": "solazstudio-web",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && eleventy",
    "start": "eleventy --serve",
    "qa:media": "node scripts/verify-media-loading.mjs",
    "qa:video": "node scripts/verify-hero-videos.mjs",
    "qa:skip-link": "node scripts/verify-skip-link.mjs",
    "qa:turnstile": "node --test scripts/verify-turnstile-hostname.test.mjs",
    "qa:f4": "npm run qa:skip-link && npm run qa:turnstile",
    "qa:scope": "node scripts/verify-f4-scope.mjs",
    "qa:parity": "node scripts/verify-parity.mjs",
    "qa": "npm run build && npm run qa:media && npm run qa:video && npm run qa:f4 && npm run qa:scope && npm run qa:parity"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.5",
    "@11ty/eleventy-img": "7.0.0",
    "nunjucks": "3.2.4"
  }
}
