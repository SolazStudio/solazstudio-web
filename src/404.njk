---
pageKey: "404"
permalink: "404.html"
---
{% extends "layouts/base.njk" %}
{% block head %}
{% include "partials/head.njk" %}
  <style>
    :root {
      --black: #0a0a0a; --black-soft: #111111; --black-mid: #1a1a1a;
      --white: #f5f3ef; --grey-light: #888580; --grey-mid: #444240;
      --grey-dark: #222220; --accent: #c8b99a;
      --font-display: 'Bebas Neue', sans-serif;
      --font-serif: 'DM Serif Display', serif;
      --font-body: 'Inter', sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: var(--font-body); overflow-x: hidden; }

    /* NAV */
    .main-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 28px 48px; background: rgba(10,10,10,0.96); backdrop-filter: blur(12px); }
    .nav-logo { font-family: var(--font-serif); font-size: 22px; color: var(--white); letter-spacing: -0.02em; text-decoration: none; }
    .nav-links { display: flex; gap: 40px; list-style: none; }
    .nav-links a { color: var(--white); text-decoration: none; font-size: 11px; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; transition: opacity 0.2s; }
    .nav-links a:hover { opacity: 1; }
    .nav-cta { font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--black); background: var(--white); padding: 10px 22px; text-decoration: none; transition: background 0.2s; }
    .nav-cta:hover { background: var(--accent); }

    /* FADE */
    .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .fade-up.visible { opacity: 1; transform: none; }

    /* ERROR PAGE */
    .error-page {
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 130px 48px 60px;
    }

    .error-mountain {
      position: absolute;
      right: -100px;
      top: 50%;
      transform: translateY(-50%);
      width: clamp(560px, 62vw, 820px);
      height: auto;
      opacity: 0.06;
      pointer-events: none;
    }

    .error-content {
      position: relative;
      z-index: 1;
      max-width: 640px;
    }

    .error-eyebrow {
      font-size: 10px; font-weight: 400; letter-spacing: 0.25em;
      text-transform: uppercase; color: var(--accent);
      display: flex; align-items: center; gap: 16px;
      margin-bottom: 32px;
    }
    .error-eyebrow::before { content: ''; display: block; width: 32px; height: 1px; background: var(--accent); }

    /* Stacked block headline — matches home/portafolio/proyectos treatment */
    .stack-headline {
      margin-bottom: 24px;
    }
    .stack-line {
      display: block;
      font-family: var(--font-display);
      font-size: clamp(44px, 7vw, 92px);
      line-height: 0.88;
      letter-spacing: 0.01em;
      color: var(--white);
    }
    .stack-line.ghost {
      color: transparent;
      -webkit-text-stroke: 1px rgba(245,243,239,0.3);
    }

    .error-subheadline {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(16px, 1.8vw, 22px);
      line-height: 1.5;
      color: var(--white);
      margin-bottom: 16px;
      max-width: 440px;
    }

    .error-message {
      font-size: 14px; font-weight: 300; color: var(--grey-light);
      line-height: 1.7; margin-bottom: 28px; max-width: 420px;
    }

    .error-cta {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--font-body); font-size: 11px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--black); background: var(--white);
      border: none; padding: 16px 36px; text-decoration: none;
      transition: background 0.2s;
    }
    .error-cta:hover { background: var(--accent); }
    .error-cta-arrow { transition: transform 0.2s; }
    .error-cta:hover .error-cta-arrow { transform: translateX(4px); }

    /* FOOTER */
    footer { padding: 40px 48px; border-top: 1px solid var(--grey-dark); display: flex; align-items: center; justify-content: space-between; gap: 32px; }
    .footer-logo { font-family: var(--font-serif); font-size: 20px; color: var(--white); opacity: 0.65; }
    .footer-copy { font-size: 11px; font-weight: 300; color: var(--grey-light); letter-spacing: 0.06em; }
    .footer-links { display: flex; gap: 32px; }
    .footer-links a { font-size: 11px; font-weight: 300; color: var(--grey-light); text-decoration: none; letter-spacing: 0.08em; transition: color 0.2s; }
    .footer-links a:hover { color: var(--white); }

    /* HAMBURGER & MOBILE MENU */
    .nav-hamburger {
      display: none; flex-direction: column; justify-content: center; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px;
      z-index: 101; position: relative;
    }
    .nav-hamburger span { display: block; width: 22px; height: 1.5px; background: var(--white); transition: all 0.3s ease; transform-origin: center; }
    .nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    .mobile-menu {
      position: fixed; inset: 0; z-index: 98; background: var(--black);
      display: flex; flex-direction: column; justify-content: center;
      padding: 100px 48px 64px; opacity: 0; pointer-events: none; transition: opacity 0.35s ease;
    }
    .mobile-menu.open { opacity: 1; pointer-events: all; }
    .mobile-menu-links { display: flex; flex-direction: column; gap: 0; margin-bottom: 48px; }
    .mobile-menu-links a {
      font-family: var(--font-display); font-size: clamp(44px, 12vw, 72px); line-height: 1.05;
      color: var(--white); text-decoration: none; opacity: 0.45; transition: opacity 0.2s;
      padding: 8px 0; border-bottom: 1px solid rgba(68,66,64,0.3);
    }
    .mobile-menu-links a:first-child { border-top: 1px solid rgba(68,66,64,0.3); }
    .mobile-menu-links a:hover { opacity: 1; }
    .mobile-menu-bottom { display: flex; flex-direction: column; gap: 16px; }
    .mobile-menu-cta {
      display: inline-block; font-family: var(--font-body); font-size: 11px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--black); background: var(--white);
      padding: 14px 32px; text-decoration: none; transition: background 0.2s; width: fit-content;
    }
    .mobile-menu-cta:hover { background: var(--accent); }
    .mobile-menu-instagram {
      font-size: 11px; font-weight: 300; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--grey-light); text-decoration: none; transition: color 0.2s;
    }
    .mobile-menu-instagram:hover { color: var(--white); }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      nav { padding: 20px 24px; }
      .error-page { padding: 130px 24px 64px; }
      footer { padding: 32px 24px; flex-direction: column; align-items: flex-start; gap: 20px; }
    }
    @media (max-width: 640px) {
      .nav-hamburger { display: flex; }
      .nav-links { display: none !important; }
    }
  </style>
{% include "partials/favicons.njk" %}
{% endblock %}
{% block body %}
  <!-- NAV -->
{% include "partials/navigation.njk" %}

{% include "partials/mobile-menu.njk" %}

  <main class="error-page">

    <svg class="error-mountain" viewBox="0 0 856.45 856.46" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="white" d="M626.38,807.95L234.37,415.94l-14.08,76.77-69.21,14.15-13.08,52.27,21.05,45.07-13.37,5.37H40.17c68.28,145.86,216.37,246.9,388.05,246.9,71.5,0,138.9-17.53,198.16-48.51M331.91,440.75l193.85-193.86c103.59,103.6,207.18,207.19,310.78,310.79,12.93-40.84,19.91-84.33,19.91-129.45C856.45,191.72,664.73,0,428.22,0S0,191.72,0,428.23c0,45.12,6.97,88.61,19.91,129.45l214.46-214.46,97.54,97.53ZM459.26,568.1l206.08,216.78c66.94-44.6,120.62-107.53,153.84-181.64l-293.42-283.62-36.58,128.57,22.5,38.57-52.42,81.35Z"/>
    </svg>

    <div class="error-content fade-up visible">
      <div class="error-eyebrow">Error 404</div>

      <h1 class="stack-headline" aria-label="Página no encontrada">
        <span class="stack-line" aria-hidden="true">PÁGINA NO</span>
        <span class="stack-line ghost" aria-hidden="true">ENCON</span>
        <span class="stack-line" aria-hidden="true">TRADA_</span>
      </h1>

      <p class="error-subheadline">Parece que este camino no lleva a ningún lado.</p>

      <p class="error-message">
        El enlace puede estar roto o la página fue movida. Vuelve al inicio y sigue explorando nuestro trabajo.
      </p>

      <a href="/" class="error-cta">
        Volver al inicio
        <span class="error-cta-arrow">→</span>
      </a>
    </div>

  </main>

  <!-- FOOTER -->
{% include "partials/footer.njk" %}

  <script>
    // Mobile menu
    const navToggle = document.getElementById('navToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    if (navToggle && mobileMenu) {
      navToggle.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        navToggle.classList.toggle('open');
        mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        mobileMenu.toggleAttribute('inert', !isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      mobileMenu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          navToggle.classList.remove('open');
          mobileMenu.setAttribute('aria-hidden', 'true');
          mobileMenu.toggleAttribute('inert', true);
          document.body.style.overflow = '';
        });
      });
    }
  </script>
{% endblock %}
