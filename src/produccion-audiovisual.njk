---
pageKey: "produccion-audiovisual"
permalink: "produccion-audiovisual.html"
---
{% extends "layouts/base.njk" %}
{% block head %}
{% include "partials/head.njk" %}
  <style>
    :root {
      --black:#0a0a0a;--black-soft:#111111;--black-mid:#1a1a1a;
      --white:#f5f3ef;--grey-light:#888580;--grey-mid:#444240;
      --grey-dark:#222220;--accent:#c8b99a;
      --font-display:'Bebas Neue',sans-serif;
      --font-serif:'DM Serif Display',serif;
      --font-body:'Inter',sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--black);color:var(--white);font-family:var(--font-body);overflow-x:hidden;}
    .main-nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:28px 48px;background:rgba(10,10,10,.96);backdrop-filter:blur(12px);}
    .nav-logo{font-family:var(--font-serif);font-size:22px;color:var(--white);letter-spacing:-.02em;text-decoration:none;}
    .nav-links{display:flex;gap:40px;list-style:none;}
    .nav-links a{color:var(--white);text-decoration:none;font-size:11px;font-weight:400;letter-spacing:.12em;text-transform:uppercase;opacity:.7;transition:opacity .2s;}
    .nav-links a:hover,.nav-links a.active{opacity:1;}
    .nav-instagram{font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--white);text-decoration:none;opacity:.6;transition:opacity .2s;}
    .ig-short{display:none;}
    .nav-instagram:hover{opacity:1;}
    .nav-cta{font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--black);background:var(--white);padding:10px 22px;text-decoration:none;transition:background .2s;}
    .nav-cta:hover{background:var(--accent);}
    .nav-hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px;z-index:101;}
    .nav-hamburger span{display:block;width:22px;height:1.5px;background:var(--white);transition:all .3s ease;}
    .nav-hamburger.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
    .nav-hamburger.open span:nth-child(2){opacity:0;}
    .nav-hamburger.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}
    .mobile-menu{position:fixed;inset:0;z-index:98;background:var(--black);display:flex;flex-direction:column;justify-content:center;padding:100px 48px 64px;opacity:0;pointer-events:none;transition:opacity .35s ease;}
    .mobile-menu.open{opacity:1;pointer-events:all;}
    .mobile-menu-links{display:flex;flex-direction:column;gap:0;margin-bottom:48px;}
    .mobile-menu-links a{font-family:var(--font-display);font-size:clamp(44px,12vw,72px);line-height:1.05;color:var(--white);text-decoration:none;opacity:.45;transition:opacity .2s;padding:8px 0;border-bottom:1px solid rgba(68,66,64,.3);}
    .mobile-menu-links a:first-child{border-top:1px solid rgba(68,66,64,.3);}
    .mobile-menu-links a:hover{opacity:1;}
    .mobile-menu-bottom{display:flex;flex-direction:column;gap:16px;}
    .mobile-menu-cta{display:inline-block;font-family:var(--font-body);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--black);background:var(--white);padding:14px 32px;text-decoration:none;width:fit-content;}
    .mobile-menu-cta:hover{background:var(--accent);}
    .mobile-menu-instagram{font-size:11px;font-weight:300;letter-spacing:.12em;text-transform:uppercase;color:var(--grey-light);text-decoration:none;}
    .fade-up{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .fade-up.visible{opacity:1;transform:none;}
    /* PAGE HERO */
    .page-hero{position:relative;padding:160px 48px 100px;border-bottom:1px solid var(--grey-dark);overflow:hidden;}
    .page-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;z-index:0;}
    .page-hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,rgba(10,10,10,.92) 50%,rgba(10,10,10,.55) 100%);}
    .page-hero-content{position:relative;z-index:1;max-width:600px;}
    .page-hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
    .page-eyebrow{font-size:10px;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;display:flex;align-items:center;gap:16px;}
    .page-eyebrow::before{content:'';display:block;width:32px;height:1px;background:var(--accent);}
    .page-hero h1{font-family:var(--font-display);font-size:clamp(48px,6vw,88px);line-height:.92;letter-spacing:-.01em;}
    .page-hero h1 .outline{color:transparent;-webkit-text-stroke:1px rgba(245,243,239,.3);}
    .hero-intro{font-family:var(--font-serif);font-style:italic;font-size:clamp(16px,2vw,22px);line-height:1.55;color:var(--white);margin-bottom:20px;}
    .hero-body{font-size:14px;font-weight:300;color:var(--grey-light);line-height:1.85;max-width:460px;}
    /* CONTENT SECTIONS */
    .content-section{padding:80px 48px;border-bottom:1px solid var(--grey-dark);}
    .content-section.alt{background:var(--black-soft);}
    .section-grid{display:grid;grid-template-columns:1fr 2fr;gap:80px;align-items:start;}
    .section-label{font-size:10px;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--accent);padding-top:4px;}
    .section-with-isotipo{position:relative;overflow:hidden;}
    .section-isotipo{position:absolute;right:-80px;top:50%;transform:translateY(-50%);width:clamp(500px,58vw,800px);height:110%;object-fit:contain;opacity:0.07;pointer-events:none;z-index:0;}
    .section-isotipo-content{position:relative;z-index:1;}
    .section-body{}
    .section-body h2{font-family:var(--font-display);font-size:clamp(32px,4vw,52px);line-height:.95;margin-bottom:24px;}
    .section-body p{font-size:14px;font-weight:300;color:var(--grey-light);line-height:1.85;margin-bottom:16px;max-width:600px;}
    .section-body p strong{color:var(--white);font-weight:400;}
    .section-body p:last-child{margin-bottom:0;}
    /* SPECIALTIES GRID */
    .spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;margin-top:40px;}
    .spec-card{padding:32px;background:rgba(26,26,26,0.4);border:1px solid rgba(68,66,64,0.45);}
    .spec-card h3{font-family:var(--font-display);font-size:22px;letter-spacing:.02em;margin-bottom:12px;color:var(--white);}
    .spec-card p{font-size:13px;font-weight:300;color:var(--grey-light);line-height:1.75;}
    /* HIGHLIGHT BOX */
    .highlight-box{margin-top:40px;padding:32px 36px;border:1px solid var(--accent);background:rgba(200,185,154,.04);}
    .highlight-box p{font-size:14px;font-weight:300;color:var(--white);line-height:1.85;}
    .highlight-box strong{color:var(--accent);font-weight:400;}
    /* CLIENTS */
    .clients-section{padding:48px;border-bottom:1px solid var(--grey-dark);display:flex;align-items:center;gap:40px;flex-wrap:wrap;}
    .clients-label{font-size:9px;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:var(--grey-mid);flex-shrink:0;}
    .clients-list{display:flex;flex-wrap:wrap;gap:8px;}
    .client-pill{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--grey-light);border:1px solid var(--grey-dark);padding:5px 12px;}
    /* CTA */
    .cta-section{padding:100px 48px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
    .cta-headline{font-family:var(--font-display);font-size:clamp(48px,6vw,80px);line-height:.92;}
    .cta-headline .outline{color:transparent;-webkit-text-stroke:1px rgba(245,243,239,.3);}
    .cta-body{font-size:14px;font-weight:300;color:var(--grey-light);line-height:1.85;margin-bottom:32px;}
    .cta-body strong{color:var(--white);font-weight:400;}
    .cta-link{font-family:var(--font-body);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--black);background:var(--white);padding:14px 32px;text-decoration:none;display:inline-block;transition:background .2s;}
    .cta-link:hover{background:var(--accent);}
    .back-link{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:300;letter-spacing:.12em;text-transform:uppercase;color:var(--grey-light);text-decoration:none;margin-top:20px;transition:color .2s;}
    .back-link:hover{color:var(--white);}
    /* FOOTER */
    footer{padding:40px 48px;border-top:1px solid var(--grey-dark);display:flex;align-items:center;justify-content:space-between;gap:32px;}
    .footer-logo{font-family:var(--font-serif);font-size:20px;color:var(--white);opacity:.65;}
    .footer-copy{font-size:11px;font-weight:300;color:var(--grey-light);letter-spacing:.06em;}
    .footer-links{display:flex;gap:32px;}
    .footer-links a{font-size:11px;font-weight:300;color:var(--grey-light);text-decoration:none;letter-spacing:.08em;transition:color .2s;}
    .footer-links a:hover{color:var(--white);}
    @media(max-width:1024px){
      .page-hero{padding:130px 32px 80px;}
      .page-hero-bg::after{background:linear-gradient(to bottom,rgba(10,10,10,.88) 40%,rgba(10,10,10,.6) 100%);}
      .section-grid,.cta-section{grid-template-columns:1fr;gap:40px;}
      .spec-grid{grid-template-columns:1fr;}
      .content-section{padding:64px 48px;}
    }
    @media(max-width:640px){
      .main-nav{padding:20px 24px;}
      .nav-hamburger{display:flex;}
      .nav-links,.nav-instagram{display:none!important;}
      .page-hero{padding:110px 24px 56px;}
      .section-isotipo{width:220px;right:-10px;top:40px;transform:none;opacity:0.035;}
      .section-isotipo-content h2{max-width:100%!important;}
      .section-isotipo-content .spec-grid{max-width:100%!important;}
      .content-section{padding:56px 24px;}
      .clients-section{padding:32px 24px;}
      .cta-section{padding:64px 24px;}
      footer{padding:32px 24px;flex-direction:column;align-items:flex-start;gap:20px;}
    }
  </style>
{% include "partials/favicons.njk" %}
{% endblock %}
{% block body %}
{% include "partials/navigation.njk" %}
{% include "partials/mobile-menu.njk" %}

  <main>


  <header class="page-hero">
    <video class="page-hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="https://media.solazstudio.cl/hero/hero-produccion-audiovisual.mp4" type="video/mp4">
      <img src="img/produccion-audiovisual.webp" alt="" aria-hidden="true">
    </video>
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-content fade-up">
      <div class="page-eyebrow">Video</div>
      <h1 aria-label="Producción audiovisual"><span aria-hidden="true">PRODUCCIÓN<br><span class="outline">AUDIO</span><br>VISUAL_</span></h1>
    
      <p class="hero-intro">Del concepto al corte final, todo en el mismo equipo.</p>
      <p class="hero-body">Producción audiovisual y video para marcas y empresas en Chile. Guion, dirección, filmación, edición y motion graphics — todo en el mismo equipo, desde la primera reunión hasta el corte final.</p>
        </div>
  </header>

  <section class="content-section section-with-isotipo fade-up">
    <svg class="section-isotipo" viewBox="0 0 856.45 856.46" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="white" d="M626.38,807.95L234.37,415.94l-14.08,76.77-69.21,14.15-13.08,52.27,21.05,45.07-13.37,5.37H40.17c68.28,145.86,216.37,246.9,388.05,246.9,71.5,0,138.9-17.53,198.16-48.51M331.91,440.75l193.85-193.86c103.59,103.6,207.18,207.19,310.78,310.79,12.93-40.84,19.91-84.33,19.91-129.45C856.45,191.72,664.73,0,428.22,0S0,191.72,0,428.23c0,45.12,6.97,88.61,19.91,129.45l214.46-214.46,97.54,97.53ZM459.26,568.1l206.08,216.78c66.94-44.6,120.62-107.53,153.84-181.64l-293.42-283.62-36.58,128.57,22.5,38.57-52.42,81.35Z"/>
    </svg>
    <div class="section-isotipo-content">
      <div class="section-label" style="margin-bottom:24px;">Tipos de producción</div>
      <h2 style="font-family:var(--font-display);font-size:clamp(32px,4vw,52px);line-height:.95;margin-bottom:40px;max-width:65%;">QUÉ HACEMOS</h2>
      <div class="spec-grid" style="max-width:65%;">
          <div class="spec-card">
            <h3>VIDEO CORPORATIVO & INSTITUCIONAL</h3>
            <p>Videos de presentación de empresa, cultura organizacional, planes de emergencia y capacitación interna. Producción completa desde el guion hasta la entrega final.</p>
          </div>
          <div class="spec-card">
            <h3>SPOTS & CAMPAÑAS PUBLICITARIAS</h3>
            <p>Piezas audiovisuales para medios digitales, televisión y plataformas sociales. Concepto, casting, locaciones, dirección y post-producción en un mismo equipo.</p>
          </div>
          <div class="spec-card">
            <h3>VIDEO DE PRODUCTO & MARCA</h3>
            <p>Videos cortos orientados a e-commerce, lanzamientos de producto y campañas digitales. Adaptados para distintos formatos: horizontal, vertical y cuadrado.</p>
          </div>
          <div class="spec-card">
            <h3>MOTION GRAPHICS</h3>
            <p>Animación gráfica para incorporar dentro de videos corporativos, presentaciones y piezas institucionales. Diseño, animación y entrega integrada al proyecto.</p>
          </div>
        </div>
        <div class="highlight-box" style="max-width:65%;margin-top:24px;">
          <p>¿Tu proyecto no encaja en ninguna de estas categorías? <strong>Cuéntanos.</strong> Hemos producido piezas muy distintas entre sí — y siempre encontramos la forma de hacerlo bien.</p>
        </div>
    </div>
  </section>

  <section class="content-section alt fade-up">
    <div class="section-grid">
      <div class="section-label">Cómo trabajamos</div>
      <div class="section-body">
        <h2>DE LA PRIMERA REUNIÓN AL CORTE FINAL</h2>
        <p>Todo parte de entender qué quieres comunicar y a quién. De ahí construimos el guion, el storyboard, el concepto visual, las locaciones y el plan de producción. Todo esto, antes de encender una cámara.</p>
        <p>En producción llegamos con equipamiento cinematográfico profesional y el equipo humano que el proyecto necesita. En post-producción editamos, colorizamos e integramos motion graphics cuando el proyecto lo requiere. El resultado es una pieza lista para publicar o presentar.</p>
        <div class="highlight-box">
          <p>Quien te atiende es el mismo equipo que llega al set y entrega el resultado. <strong>Tu proyecto no pasa por manos que no conoces.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <div class="clients-section fade-up">
    <span class="clients-label">Han confiado en nosotros</span>
    <div class="clients-list">
      <span class="client-pill">WEG Chile</span>
      <span class="client-pill">Puerto Rolls</span>
      <span class="client-pill">Kifit</span>
      <span class="client-pill">Johnny Rockets</span>
      <span class="client-pill">Cassone</span>
      <span class="client-pill">Aistana</span>
      <span class="client-pill">Cáscara Foods</span>
    </div>
  </div>

  <section class="cta-section fade-up">
    <h2 class="cta-headline">HABLEMOS<br><span class="outline">DE TU</span><br>PROYECTO_</h2>
    <div>
      <p class="cta-body">¿Tienes una idea, un guion o solo el objetivo claro? <strong>Con eso es suficiente para empezar.</strong></p>
      <a href="/contacto?service_code=produccion_audiovisual&amp;source_page=%2Fproduccion-audiovisual&amp;cta_id=service_primary" class="cta-link">Solicitar presupuesto →</a>
      <br>
      <a href="/servicios" class="back-link">← Ver todos los servicios</a>
    </div>
  </section>
    
  <div class="fade-up" style="padding:0 48px 48px;">
    <p style="font-size:11px;font-weight:300;letter-spacing:.12em;text-transform:uppercase;color:var(--grey-light);margin-bottom:12px;">Proyectos relacionados</p>
    <div style="display:flex;flex-direction:column;gap:4px;">
      <a href="/proyectos/video-corporativo-weg-chile" class="back-link">WEG Chile — Transformador Antofagasta →</a>
      <a href="/proyectos/campana-publicitaria-elige-educar-mineduc" class="back-link">Elige Educar × Mineduc →</a>
    </div>
  </div>
</main>

{% include "partials/footer.njk" %}

  <script>
    
    
    const t=document.getElementById('navToggle'),m=document.getElementById('mobileMenu');
    if(t&&m){t.addEventListener('click',()=>{const o=m.classList.toggle('open');t.classList.toggle('open');m.setAttribute('aria-hidden',String(!o));m.toggleAttribute('inert',!o);document.body.style.overflow=o?'hidden':'';});m.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');t.classList.remove('open');m.setAttribute('aria-hidden','true');m.toggleAttribute('inert',true);document.body.style.overflow='';}));}
    const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');}),{threshold:.08});
    document.querySelectorAll('.fade-up').forEach(el=>obs.observe(el));
  </script>
{% endblock %}
