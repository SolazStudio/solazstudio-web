{% set page = pages[pageKey] %}
  <nav class="main-nav" aria-label="Navegación principal">
    <a href="/" class="nav-logo"{% if page.navigation.logoAriaLabel %} aria-label="{{ page.navigation.logoAriaLabel | safe }}"{% endif %}>solaz</a>
    <ul class="nav-links">
{% for item in navigation %}
      <li><a href="{{ item.href }}"{% if page.navigation.activeKey == item.key %} class="active"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
    </ul>
{% if page.navigation.showInstagram %}
    <a href="{{ site.instagramUrl }}" class="nav-instagram" target="_blank" rel="noopener"{% if page.navigation.instagramAriaLabel %} aria-label="{{ page.navigation.instagramAriaLabel | safe }}"{% endif %}><span class="ig-full">Instagram</span><span class="ig-short">IG</span></a>
{% endif %}
    <a href="/contacto" class="nav-cta{% if page.navigation.contactActive %} active{% endif %}">Contacto</a>
    <button type="button" class="nav-hamburger" id="navToggle" aria-label="Abrir menú"{% if page.navigation.expanded %} aria-expanded="false"{% endif %}>
      <span></span><span></span><span></span>
    </button>
  </nav>
